// =============================================================================
// OpenList-TSWorker · Cloudflare Workers 配置
// 文档：https://developers.cloudflare.com/workers/wrangler/configuration/
//
// ⚠️ 本项目的「绑定（D1 / KV 等）」与「环境变量（DB_* 等）」统一在 Cloudflare
// 面板（Dashboard）维护，不写进本文件。原因：wrangler deploy 会用本文件的
// vars / bindings 覆盖线上面板配置，导致每次自动部署后变量被打回默认值。
// 因此这里刻意不声明 vars 与存储绑定，部署只更新代码，配置以面板为准。
//
// Secret（JWT_SECRET / ADMIN_PASS / ALLOW_URLS / MYSQL_URLS / EO_KV_URLS / CF_* 等）
// 请在 .dev.vars.example 或 .env.example 中声明 —— 部署按钮据此生成输入项，
// 用户填入的值会成为该 Worker 的 Secret，后续更新不会被覆盖。
// =============================================================================
{
  "name": "openlist-worker",
  "main": "src/backend/worker.ts",

  // iconv-lite 只有 FTP 驱动在用，而 Workers 没有 TCP socket、FTP 驱动不可用。
  // build-edge.mjs 早已把 iconv-lite 当作 external / 空模块，但 `wrangler deploy`
  // 不经过那条链路，仍会去解析它以及它的传递依赖 safer-buffer（issue #151）。
  // 这里指向空桩，让 Wrangler 的打包与其它产物的行为一致。
  "alias": {
    "iconv-lite": "./src/backend/drivers/ftp/iconv-stub.ts"
  },
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // 关键：保留面板上已有的变量与绑定，避免每次部署被本文件覆盖/删除。
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html"]
  },

  // ===========================================================================
  // 环境变量（vars）：刻意留空 —— 统一在 Cloudflare 面板维护。
  // 若在此声明，每次 wrangler deploy 都会覆盖线上面板里同名的普通变量。
  // 需要的变量（在面板 Settings → Variables and secrets 设置）：
  //   ENVIRONMENT / DB_FORMAT / DB_DRIVER / DB_CIPHER 等
  // ===========================================================================
  "vars": {},

  // ===========================================================================
  // 存储绑定：刻意留空 —— 统一在 Cloudflare 面板维护。
  // 若在此声明，每次 wrangler deploy 都会覆盖线上面板里的绑定配置。
  // 需要的绑定（在面板 Settings → Bindings 维护）：
  //   - D1 数据库绑定名 DB
  //   - KV 命名空间绑定名 KV（如使用）
  //   - R2 / Durable Objects 等按需
  // ===========================================================================
}

