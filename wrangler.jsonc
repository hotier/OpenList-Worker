// =============================================================================
// OpenList-TSWorker · Cloudflare Workers 配置
// 文档：https://developers.cloudflare.com/workers/wrangler/configuration/
//
// ⚠️ 重要：D1 / KV 等「绑定」必须写在本文件里。
//   wrangler deploy 会用本文件的 bindings 覆盖线上，keep_vars 只保护明文变量、
//   不保护绑定；若本文件不声明绑定，部署会把线上的 D1/KV 绑定删除。
//   因此绑定在此声明，保证每次自动部署都保留。
//
// 普通变量（DB_* 等）也可在此声明以固化；面板上的同名明文变量会被本文件覆盖。
//
// Secret（JWT_SECRET / ADMIN_PASS / ALLOW_URLS / MYSQL_URLS / EO_KV_URLS / CF_* 等）
// 不会被 wrangler deploy 覆盖，保持面板/secret 管理即可。
// =============================================================================
{
  "name": "openlist-worker",
  "main": "src/backend/worker.ts",

  // iconv-lite 只有 FTP 驱动在用，而 Workers 没有 TCP socket、FTP 驱动不可用。
  // build-edge.mjs 早已把 iconv-lite 当作 external / 空模块，但 `wrangler deploy`
  // 不经过那条链路，仍会去解析它以及它的传递依赖 safer-buffer（issue #151）。
  // 这里指向空桩，让 Wrangler 的打包与其它产物的行为一致。
  "alias": {
    "iconv-lite": "./src/backend/drivers/ftp/iconv-stub.ts"
  },
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html"]
  },

  // ===========================================================================
  // 普通环境变量（vars）：在此固化，保证每次部署结果稳定。
  // ===========================================================================
  "vars": {
    "ENVIRONMENT": "production",
    "DB_FORMAT": "sql",
    "DB_DRIVER": "d1",
    "DB_CIPHER": "none"
  },

  // ===========================================================================
  // 存储绑定：必须声明，否则部署会删除线上绑定。
  // ===========================================================================
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opnelist",
      "database_id": "9f53029f-95a9-4257-86d0-3d6d05dff113"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "111a57d369a041b8a2940ff65aef81dc"
    }
  ]
}


